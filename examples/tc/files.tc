// files.tc - sandboxed file I/O. Run with:  tvm -fs DIR files.tvb
char name[] = "numbers.txt";
char line[16];

void main() {
    int h; int i; int c; int n = 0; int total = 0;
    h = fopen(name, 1);                              // 1 = write
    if (h < 0) { puts("file I/O is disabled (run: tvm -fs DIR prog.tvb)"); exit(1); }
    for (i = 1; i <= 5; i++) {
        itoa(i * i, line);
        fwrite(h, line, strlen(line));
        fputc(h, 10);
    }
    fclose(h);
    h = fopen(name, 0);                              // 0 = read
    c = fgetc(h);
    while (c >= 0) {
        if (c == 10) { total += n; n = 0; } else n = n * 10 + c - 48;
        c = fgetc(h);
    }
    fclose(h);
    fremove(name);
    print("sum of squares = "); puti(total); putc(10);
}
